# Copy to .env.local for `npm run dev`, or pull the project's values with `vercel env pull .env.local`.
# On Vercel, set the same names as sensitive environment variables. Never commit real values.

# Reactor FastH3 Omni (https://reactor.inc) — server-side only, exchanged for short-lived session tokens.
REACTOR_API_KEY=replace_me
# OpenAI — speech-to-text for spoken ultimates.
OPENAI_API_KEY=replace_me
# Agora RTC/RTM (https://console.agora.io) — the certificate signs tokens on the server.
AGORA_APP_ID=replace_me
AGORA_APP_CERTIFICATE=replace_me
# Shared password for the deployed site (the Vercel middleware fails closed without it; not used by `npm run dev`).
ARENA_ACCESS_PASSWORD=replace_me
